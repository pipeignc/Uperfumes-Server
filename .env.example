# Copia este archivo a ".env" y ajusta los valores. "node_modules" y ".env"
# NUNCA deben subirse a un repositorio (ver .gitignore).

# ---------------------------------------------------------------------------
# Servidor
# ---------------------------------------------------------------------------
PORT=3000

# URL pública donde queda publicado este servidor (sin / al final).
# Se usa para armar la returnUrl que Transbank llama de vuelta.
# En desarrollo local normalmente es http://localhost:3000
PUBLIC_BASE_URL=http://localhost:3000

# Cuántos proxies hay entre internet y este servidor. En Railway, Render o
# Fly.io es 1 (déjalo así). Si lo corres directo a internet, ponlo en 0.
TRUST_PROXY=1

# Origen permitido para CORS. Si el frontend se sirve desde este mismo
# servidor (carpeta /public), puedes dejarlo igual a PUBLIC_BASE_URL.
ALLOWED_ORIGIN=http://localhost:3000

# ---------------------------------------------------------------------------
# Base de datos SQLite
# ---------------------------------------------------------------------------
# Ruta del archivo de base de datos (se crea solo la primera vez que corre).
DATABASE_PATH=./data/uperfumes.sqlite

# ---------------------------------------------------------------------------
# Transbank Webpay Plus
# ---------------------------------------------------------------------------
# TRANSBANK_ENVIRONMENT: "integration" (pruebas) o "production" (real).
TRANSBANK_ENVIRONMENT=integration

# Los valores de abajo son las credenciales PÚBLICAS de prueba que publica
# Transbank para que cualquier desarrollador pueda integrar y probar Webpay
# Plus sin tener comercio propio todavía. Están documentadas en
# transbankdevelopers.cl — no son un secreto y vienen puestas a propósito
# para que el proyecto funcione "out of the box" en modo prueba.
#
# Cuando Transbank apruebe tu afiliación como comercio real, reemplaza estos
# dos valores por tu código de comercio y API key de PRODUCCIÓN, y cambia
# TRANSBANK_ENVIRONMENT a "production". Esos valores si son secretos de
# verdad: no los subas a ningún repositorio público.
TRANSBANK_COMMERCE_CODE=597055555532
TRANSBANK_API_KEY=579B532A7440BB0C9079DED94D31EA1615BACEB56610332264630D42D0A36B1C
