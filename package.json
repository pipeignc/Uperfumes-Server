{
  "name": "uperfumes-server",
  "version": "1.0.0",
  "description": "Backend de UPerfumes: guarda pedidos en SQLite y procesa pagos con Webpay Plus (Transbank).",
  "private": true,
  "type": "commonjs",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node test/e2e.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "better-sqlite3": "^12.10.0",
