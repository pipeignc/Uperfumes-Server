    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "express-validator": "^7.2.0",
    "helmet": "^7.1.0",
    "transbank-sdk": "^6.1.0"
  },
  "devDependencies": {
    "jsdom": "^30.1.2"
  },
  "allowScripts": {
    "better-sqlite3@12.10.0": true
  }
