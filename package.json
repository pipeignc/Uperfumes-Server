{
  "name": "uperfumes-server",
  "version": "1.0.0",
  "description": "Backend de UPerfumes: guarda pedidos en SQLite y procesa pagos con Webpay Plus (Transbank).",
  "private": true,
  "type": "commonjs",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node test/e2e.js",
    "python:train": ".venv/bin/python -m python_service.imperative --csv python_service/data/DATASET_PROTOTIPO.csv",
    "python:dev": ".venv/bin/python -m uvicorn python_service.app:app --host 127.0.0.1 --port 8000",
    "test:python": ".venv/bin/python -m unittest discover -s python_tests -v",
    "test:python-ui": "node --test integration/python-features.test.cjs"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "better-sqlite3": "^12.10.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "express-validator": "^7.2.0",
    "helmet": "^7.1.0",
    "transbank-sdk": "^6.1.0"
  },
  "devDependencies": {
    "jsdom": "^30.1.2"
  },
  "allowScripts": {
    "better-sqlite3@12.10.0": true
  }
}
